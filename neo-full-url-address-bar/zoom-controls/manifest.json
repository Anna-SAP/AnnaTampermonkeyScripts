{
  "manifest_version": 3,
  "name": "Neo Zoom Controls",
  "description": "Page zoom controls in the toolbar: zoom out, current level (click to reset) and zoom in.",
  "version": "1.0.0",
  "key": "",
  "action": {
    "default_title": "页面缩放",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
